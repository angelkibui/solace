rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && 'admin' in request.auth.token
        && request.auth.token.admin == true;
    }

    function isAssignedTherapist(therapistId) {
      return signedIn()
        && get(/databases/$(database)/documents/therapists/$(therapistId)).data.providerUid
          == request.auth.uid;
    }

    function validAlias(alias) {
      return alias is string && alias.size() >= 3 && alias.size() <= 24;
    }

    function validPreferences(preferences) {
      return preferences is list && preferences.size() <= 20;
    }

    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'alias', 'email', 'createdAt', 'preferences', 'onboardingComplete'
        ])
        && validAlias(request.resource.data.alias)
        && request.resource.data.email is string
        && request.resource.data.createdAt is timestamp
        && validPreferences(request.resource.data.preferences)
        && request.resource.data.onboardingComplete is bool;
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['alias', 'preferences', 'onboardingComplete'])
        && validAlias(request.resource.data.alias)
        && validPreferences(request.resource.data.preferences)
        && request.resource.data.onboardingComplete is bool;
      allow delete: if isOwner(userId);
    }

    match /therapists/{therapistId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.therapistId is string
        && request.resource.data.dateTime is timestamp
        && request.resource.data.amount is int;
      allow read: if isOwner(resource.data.userId)
        || isAssignedTherapist(resource.data.therapistId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.therapistId == resource.data.therapistId
        && request.resource.data.amount == resource.data.amount;
      allow delete: if isOwner(resource.data.userId);
    }

    match /transactions/{transactionId} {
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.appointmentId is string
        && request.resource.data.transactionId is string
        && request.resource.data.amount is int;
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.appointmentId == resource.data.appointmentId
        && request.resource.data.transactionId == resource.data.transactionId
        && request.resource.data.amount == resource.data.amount;
      allow delete: if isOwner(resource.data.userId);
    }

    function chatDocument(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId));
    }

    function isChatParticipant(chatId) {
      return signedIn()
        && (chatDocument(chatId).data.userId == request.auth.uid
          || chatDocument(chatId).data.providerUid == request.auth.uid);
    }

    match /chats/{chatId} {
      allow get: if isChatParticipant(chatId)
        || (signedIn()
          && get(/databases/$(database)/documents/appointments/$(chatId)).data.userId
            == request.auth.uid);
      allow list: if isChatParticipant(chatId);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'appointmentId', 'userId', 'therapistId', 'providerUid', 'createdAt'
        ])
        && request.resource.data.appointmentId == chatId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.createdAt == request.time
        && get(/databases/$(database)/documents/appointments/$(chatId)).data.userId
          == request.auth.uid
        && get(/databases/$(database)/documents/appointments/$(chatId)).data.therapistId
          == request.resource.data.therapistId
        && get(/databases/$(database)/documents/appointments/$(chatId)).data.status
          == 'confirmed'
        && get(/databases/$(database)/documents/therapists/$(request.resource.data.therapistId)).data.providerUid
          == request.resource.data.providerUid;
      allow update, delete: if false;

      match /messages/{messageId} {
        allow read: if isChatParticipant(chatId);
        allow create: if isChatParticipant(chatId)
          && request.resource.data.keys().hasOnly([
            'senderId', 'senderAlias', 'text', 'createdAt', 'isRead'
          ])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time
          && request.resource.data.isRead == false
          && ((request.auth.uid == chatDocument(chatId).data.userId
              && request.resource.data.senderAlias
                == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.alias)
            || (request.auth.uid == chatDocument(chatId).data.providerUid
              && request.resource.data.senderAlias
                == get(/databases/$(database)/documents/therapists/$(chatDocument(chatId).data.therapistId)).data.name));
        allow update: if isChatParticipant(chatId)
          && resource.data.senderId != request.auth.uid
          && resource.data.isRead == false
          && request.resource.data.isRead == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead']);
        allow delete: if false;
      }
    }

    match /circles/{circleId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (signedIn()
          && resource.data.memberIds is list
          && request.resource.data.memberIds is list
          && resource.data.memberCount is int
          && request.resource.data.memberCount is int
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['memberIds', 'memberCount'])
          && (
            (request.resource.data.memberIds.hasAll(resource.data.memberIds)
              && request.resource.data.memberIds.hasAny([request.auth.uid])
              && !resource.data.memberIds.hasAny([request.auth.uid])
              && request.resource.data.memberIds.size()
                == resource.data.memberIds.size() + 1
              && request.resource.data.memberCount == resource.data.memberCount + 1)
            || (resource.data.memberIds.hasAll(request.resource.data.memberIds)
              && resource.data.memberIds.hasAny([request.auth.uid])
              && !request.resource.data.memberIds.hasAny([request.auth.uid])
              && request.resource.data.memberIds.size()
                == resource.data.memberIds.size() - 1
              && resource.data.memberCount > 0
              && request.resource.data.memberCount == resource.data.memberCount - 1)
          ));
    }
  }
}
