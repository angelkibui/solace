rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function isAssignedTherapist(therapistId) {
      return signedIn()
        && get(/databases/$(database)/documents/therapists/$(therapistId)).data.providerUid
          == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /therapists/{therapistId} {
      allow read: if signedIn();
      allow create, update, delete: if isAdmin();
    }

    match /appointments/{appointmentId} {
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.therapistId is string
        && request.resource.data.dateTime is timestamp
        && request.resource.data.amount is int;
      allow read: if isOwner(resource.data.userId)
        || isAssignedTherapist(resource.data.therapistId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.therapistId == resource.data.therapistId
        && request.resource.data.amount == resource.data.amount;
      allow delete: if isOwner(resource.data.userId);
    }

    match /transactions/{transactionId} {
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.appointmentId is string
        && request.resource.data.transactionId is string
        && request.resource.data.amount is int;
      allow read: if isOwner(resource.data.userId);
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.appointmentId == resource.data.appointmentId
        && request.resource.data.transactionId == resource.data.transactionId
        && request.resource.data.amount == resource.data.amount;
      allow delete: if isOwner(resource.data.userId);
    }

    match /circles/{circleId} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      // Anyone signed in can join/leave, but only by adding or removing
      // *their own* uid from memberIds (never someone else's), and only
      // touching memberIds/memberCount -- no other field. Admins can still
      // update anything (moderation, renaming, etc.).
      allow update: if isAdmin()
        || (signedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds', 'memberCount'])
          && (
            (request.resource.data.memberIds.hasAll(resource.data.memberIds)
              && request.resource.data.memberIds.hasAny([request.auth.uid])
              && !resource.data.memberIds.hasAny([request.auth.uid])
              && request.resource.data.memberCount == resource.data.memberCount + 1)
            || (resource.data.memberIds.hasAll(request.resource.data.memberIds)
              && resource.data.memberIds.hasAny([request.auth.uid])
              && !request.resource.data.memberIds.hasAny([request.auth.uid])
              && request.resource.data.memberCount == resource.data.memberCount - 1)
          ));
    }
  }
}
